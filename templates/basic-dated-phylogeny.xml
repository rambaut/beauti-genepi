<!--@beauti-genepi
{
  "name": "Basic dated phylogeny",
  "version": "0.1",
  "author": "BEAUti|GenEpi",
  "description": "HKY substitution model with optional gamma rate heterogeneity, a strict or relaxed molecular clock and a constant-size coalescent tree prior.",
  "requires": ["alignment", "dates"],
  "steps": [
    {
      "id": "substitution",
      "title": "Substitution model",
      "icon": "shuffle",
      "description": "The HKY model of nucleotide substitution.",
      "controls": [
        { "id": "gamma", "type": "checkbox", "label": "Gamma-distributed rate heterogeneity (4 categories)", "default": true }
      ]
    },
    {
      "id": "clock",
      "title": "Clock model",
      "icon": "clock-history",
      "controls": [
        { "id": "clockModel", "type": "select", "label": "Molecular clock",
          "options": [
            { "value": "strict", "label": "Strict clock" },
            { "value": "ucln", "label": "Uncorrelated relaxed clock (lognormal)" }
          ],
          "default": "strict" },
        { "id": "clockRate", "type": "number", "label": "Initial clock rate (substitutions/site/year)",
          "min": 0, "default": 0.001 },
        { "id": "clockStdev", "type": "number", "label": "Initial relaxed clock standard deviation",
          "min": 0, "default": 0.3333, "visibleIf": "clockModel == \"ucln\"" }
      ]
    },
    {
      "id": "tree-prior",
      "title": "Tree prior",
      "icon": "diagram-3",
      "description": "A constant-size coalescent prior on the tree.",
      "controls": [
        { "id": "populationSize", "type": "number", "label": "Initial population size", "min": 0, "default": 1.0 }
      ]
    },
    {
      "id": "mcmc",
      "title": "MCMC",
      "icon": "repeat",
      "controls": [
        { "id": "chainLength", "type": "integer", "label": "Chain length", "min": 1, "default": 10000000 },
        { "id": "logEvery", "type": "integer", "label": "Log parameters every", "min": 1, "default": 1000 },
        { "id": "screenLogEvery", "type": "integer", "label": "Echo to screen every", "min": 1, "default": 10000 },
        { "id": "fileStem", "type": "text", "label": "File name stem", "default": "analysis",
          "required": true, "pattern": "[A-Za-z0-9._-]+",
          "patternMessage": "Use letters, numbers, dots, dashes and underscores only." }
      ]
    }
  ]
}
-->
<?xml version="1.0" standalone="yes"?>
<!-- Generated by BEAUti|GenEpi -->
<beast version="1.10.4">

	<taxa id="taxa">
{{#each taxon in taxa}}
		<taxon id="${taxon.id}">
{{#if taxon.date}}
			<date value="${taxon.date}" direction="forwards" units="years"/>
{{/if}}
		</taxon>
{{/each}}
	</taxa>

	<alignment id="alignment" dataType="nucleotide">
{{#each taxon in taxa}}
		<sequence>
			<taxon idref="${taxon.id}"/>
			${taxon.sequence}
		</sequence>
{{/each}}
	</alignment>

	<patterns id="patterns" from="1" strip="false">
		<alignment idref="alignment"/>
	</patterns>

	<constantSize id="constant" units="years">
		<populationSize>
			<parameter id="constant.popSize" value="${populationSize}" lower="0.0"/>
		</populationSize>
	</constantSize>

	<coalescentSimulator id="startingTree">
		<taxa idref="taxa"/>
		<constantSize idref="constant"/>
	</coalescentSimulator>

	<treeModel id="treeModel">
		<coalescentTree idref="startingTree"/>
		<rootHeight>
			<parameter id="treeModel.rootHeight"/>
		</rootHeight>
		<nodeHeights internalNodes="true">
			<parameter id="treeModel.internalNodeHeights"/>
		</nodeHeights>
		<nodeHeights internalNodes="true" rootNode="true">
			<parameter id="treeModel.allInternalNodeHeights"/>
		</nodeHeights>
	</treeModel>

	<treeLengthStatistic id="treeLength">
		<treeModel idref="treeModel"/>
	</treeLengthStatistic>

	<tmrcaStatistic id="age(root)" absolute="true">
		<treeModel idref="treeModel"/>
		<mrca>
			<taxa idref="taxa"/>
		</mrca>
	</tmrcaStatistic>

	<coalescentLikelihood id="coalescent">
		<model>
			<constantSize idref="constant"/>
		</model>
		<populationTree>
			<treeModel idref="treeModel"/>
		</populationTree>
	</coalescentLikelihood>

{{#if clockModel == "strict"}}
	<strictClockBranchRates id="branchRates">
		<rate>
			<parameter id="clock.rate" value="${clockRate}" lower="0.0"/>
		</rate>
	</strictClockBranchRates>
{{else}}
	<discretizedBranchRates id="branchRates">
		<treeModel idref="treeModel"/>
		<distribution>
			<logNormalDistributionModel meanInRealSpace="true">
				<mean>
					<parameter id="ucld.mean" value="${clockRate}" lower="0.0"/>
				</mean>
				<stdev>
					<parameter id="ucld.stdev" value="${clockStdev}" lower="0.0"/>
				</stdev>
			</logNormalDistributionModel>
		</distribution>
		<rateCategories>
			<parameter id="branchRates.categories"/>
		</rateCategories>
	</discretizedBranchRates>

	<rateStatistic id="meanRate" name="meanRate" mode="mean" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<discretizedBranchRates idref="branchRates"/>
	</rateStatistic>

	<rateStatistic id="coefficientOfVariation" name="coefficientOfVariation" mode="coefficientOfVariation" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<discretizedBranchRates idref="branchRates"/>
	</rateStatistic>
{{/if}}

	<HKYModel id="hky">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<kappa>
			<parameter id="kappa" value="2.0" lower="0.0"/>
		</kappa>
	</HKYModel>

	<siteModel id="siteModel">
		<substitutionModel>
			<HKYModel idref="hky"/>
		</substitutionModel>
{{#if gamma}}
		<gammaShape gammaCategories="4">
			<parameter id="alpha" value="0.5" lower="0.0"/>
		</gammaShape>
{{/if}}
	</siteModel>

	<treeDataLikelihood id="treeLikelihood" useAmbiguities="false">
		<partition>
			<patterns idref="patterns"/>
			<siteModel idref="siteModel"/>
		</partition>
		<treeModel idref="treeModel"/>
{{#if clockModel == "strict"}}
		<strictClockBranchRates idref="branchRates"/>
{{else}}
		<discretizedBranchRates idref="branchRates"/>
{{/if}}
	</treeDataLikelihood>

	<operators id="operators" optimizationSchedule="log">
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="kappa"/>
		</scaleOperator>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="frequencies"/>
		</deltaExchange>
{{#if gamma}}
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="alpha"/>
		</scaleOperator>
{{/if}}
{{#if clockModel == "strict"}}
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="clock.rate"/>
		</scaleOperator>
{{else}}
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="ucld.mean"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="ucld.stdev"/>
		</scaleOperator>
		<swapOperator size="1" weight="10" autoOptimize="false">
			<parameter idref="branchRates.categories"/>
		</swapOperator>
		<uniformIntegerOperator weight="10">
			<parameter idref="branchRates.categories"/>
		</uniformIntegerOperator>
{{/if}}
		<subtreeLeap size="1.0" weight="30">
			<treeModel idref="treeModel"/>
		</subtreeLeap>
		<fixedHeightSubtreePruneRegraft weight="3">
			<treeModel idref="treeModel"/>
		</fixedHeightSubtreePruneRegraft>
		<scaleOperator scaleFactor="0.75" weight="3">
			<parameter idref="constant.popSize"/>
		</scaleOperator>
	</operators>

	<mcmc id="mcmc" chainLength="${chainLength}" autoOptimize="true">
		<joint id="joint">
			<prior id="prior">
				<logNormalPrior mu="1.0" sigma="1.25" offset="0.0">
					<parameter idref="kappa"/>
				</logNormalPrior>
				<uniformPrior lower="0.0" upper="1.0">
					<parameter idref="frequencies"/>
				</uniformPrior>
{{#if gamma}}
				<exponentialPrior mean="0.5" offset="0.0">
					<parameter idref="alpha"/>
				</exponentialPrior>
{{/if}}
{{#if clockModel == "strict"}}
				<ctmcScalePrior>
					<ctmcScale>
						<parameter idref="clock.rate"/>
					</ctmcScale>
					<treeModel idref="treeModel"/>
				</ctmcScalePrior>
{{else}}
				<ctmcScalePrior>
					<ctmcScale>
						<parameter idref="ucld.mean"/>
					</ctmcScale>
					<treeModel idref="treeModel"/>
				</ctmcScalePrior>
				<exponentialPrior mean="0.3333" offset="0.0">
					<parameter idref="ucld.stdev"/>
				</exponentialPrior>
{{/if}}
				<oneOnXPrior>
					<parameter idref="constant.popSize"/>
				</oneOnXPrior>
				<coalescentLikelihood idref="coalescent"/>
			</prior>
			<likelihood id="likelihood">
				<treeDataLikelihood idref="treeLikelihood"/>
			</likelihood>
		</joint>

		<operators idref="operators"/>

		<log id="screenLog" logEvery="${screenLogEvery}">
			<column label="Joint" dp="4" width="12">
				<joint idref="joint"/>
			</column>
			<column label="Prior" dp="4" width="12">
				<prior idref="prior"/>
			</column>
			<column label="Likelihood" dp="4" width="12">
				<likelihood idref="likelihood"/>
			</column>
			<column label="age(root)" sf="6" width="12">
				<tmrcaStatistic idref="age(root)"/>
			</column>
			<column label="rate" sf="6" width="12">
{{#if clockModel == "strict"}}
				<parameter idref="clock.rate"/>
{{else}}
				<rateStatistic idref="meanRate"/>
{{/if}}
			</column>
		</log>

		<log id="fileLog" logEvery="${logEvery}" fileName="${fileStem}.log" overwrite="false">
			<joint idref="joint"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<parameter idref="treeModel.rootHeight"/>
			<tmrcaStatistic idref="age(root)"/>
			<treeLengthStatistic idref="treeLength"/>
			<parameter idref="constant.popSize"/>
			<parameter idref="kappa"/>
			<parameter idref="frequencies"/>
{{#if gamma}}
			<parameter idref="alpha"/>
{{/if}}
{{#if clockModel == "strict"}}
			<parameter idref="clock.rate"/>
{{else}}
			<parameter idref="ucld.mean"/>
			<parameter idref="ucld.stdev"/>
			<rateStatistic idref="meanRate"/>
			<rateStatistic idref="coefficientOfVariation"/>
{{/if}}
			<treeDataLikelihood idref="treeLikelihood"/>
			<coalescentLikelihood idref="coalescent"/>
		</log>

		<logTree id="treeFileLog" logEvery="${logEvery}" nexusFormat="true" fileName="${fileStem}.trees" sortTranslationTable="true">
			<treeModel idref="treeModel"/>
			<trait name="rate" tag="rate">
{{#if clockModel == "strict"}}
				<strictClockBranchRates idref="branchRates"/>
{{else}}
				<discretizedBranchRates idref="branchRates"/>
{{/if}}
			</trait>
			<joint idref="joint"/>
		</logTree>
	</mcmc>

	<report>
		<property name="timer">
			<mcmc idref="mcmc"/>
		</property>
	</report>

</beast>
